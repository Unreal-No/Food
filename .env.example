# ไม่ตั้ง = ใช้ PGlite ใน .data/ (dev)
DATABASE_URL=
# รหัสเข้าหลังบ้าน (dev ค่าเริ่มต้น "admin", production ต้องตั้ง)
ADMIN_PASSWORD=
# สุ่มยาวๆ สำหรับเซ็น session cookie
AUTH_SECRET=
# URL จริงของเว็บ (ใช้สร้าง QR โต๊ะ) เช่น https://shop.example.com
SITE_URL=
# ทดสอบ LINE กับ mock server (ปกติเว้นว่าง)
LINE_API_BASE=
# ผู้ช่วย AI + นำเข้าเมนูจากรูป (เว้นว่าง = ปิด)
ANTHROPIC_API_KEY=
# BARISTA_MODEL=claude-haiku-5-5
# MENU_IMPORT_MODEL=claude-sonnet-5-5
# Postgres แบบ session (realtime LISTEN) เมื่อ DATABASE_URL เป็น transaction pooler
DATABASE_LISTEN_URL=
# เข้ารหัสข้อมูลลับ (token LINE)
DATA_KEY=
# Supabase Storage (ไม่ตั้ง = เก็บไฟล์ในเครื่อง)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=media
